<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 12+ replacement for backup_rules.xml. Same choice of files, but
  cloud backup and device-to-device transfer are now declared separately.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="progress.db"/>
        <include domain="database" path="progress.db-wal"/>
        <include domain="database" path="progress.db-shm"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="progress.db"/>
        <include domain="database" path="progress.db-wal"/>
        <include domain="database" path="progress.db-shm"/>
    </device-transfer>
</data-extraction-rules>
